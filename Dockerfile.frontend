FROM node:18-alpine as builder

WORKDIR /app

# Copy package files
COPY enterprise-ui/package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY enterprise-ui/src ./src
COPY enterprise-ui/public ./public

# API base URL for the frontend to call the backend.
# CRA inlines REACT_APP_* vars at build time, so this must be set here
# (not just at runtime). Defaults to empty so the app fails gracefully
# with an error message instead of crashing when no backend is configured.
ARG REACT_APP_API_URL="https://web-production-4437d.up.railway.app"
ENV REACT_APP_API_URL=${REACT_APP_API_URL}

# Build the app
RUN npm run build

# Production stage - serve the build on Railway's assigned port
FROM node:18-alpine

WORKDIR /app

# Copy built files into the runtime image
COPY --from=builder /app/build ./build

# Install a static server that respects the PORT environment variable
RUN npm install -g serve

# Railway health checks the deployed app over /health
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=5 \
  CMD sh -c 'wget -qO- "http://127.0.0.1:${PORT:-8080}/health" >/dev/null 2>&1 || exit 1'

EXPOSE 8080

CMD ["sh", "-c", "serve -s /app/build -l ${PORT:-8080}"]
